{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MANASTORM",
  "version": "1.0.0",
  "identifier": "com.manastorm.tcg",
  "build": {
    "beforeDevCommand": "node scripts/build-dist.js",
    "beforeBuildCommand": "node scripts/build-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MANASTORM — Tactical TCG Roguelike",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "CardGame",
    "shortDescription": "MTG × Balatro Tactical TCG Deckbuilder",
    "longDescription": "MANASTORM is a tactical deckbuilding roguelike combining MTG mana and combat rules with Balatro resonance multipliers, tactile 3D cards, and spring-physics drag-to-play.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
